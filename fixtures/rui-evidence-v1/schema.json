{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireContract",
  "description": "Schema roots include the parsed body contract even though transport retains its exact string bytes.",
  "type": "object",
  "properties": {
    "artifact_envelope": {
      "$ref": "#/$defs/QueryEnvelope2"
    },
    "artifact_request": {
      "$ref": "#/$defs/ArtifactRequest"
    },
    "artifact_result": {
      "$ref": "#/$defs/ArtifactResult"
    },
    "error": {
      "$ref": "#/$defs/ProtocolError"
    },
    "export_envelope": {
      "$ref": "#/$defs/QueryEnvelope"
    },
    "export_page": {
      "$ref": "#/$defs/ExportPage"
    },
    "export_request": {
      "$ref": "#/$defs/ExportRequest"
    },
    "record_body": {
      "$ref": "#/$defs/RecordBody"
    }
  },
  "required": [
    "export_envelope",
    "artifact_envelope",
    "export_request",
    "export_page",
    "record_body",
    "artifact_request",
    "artifact_result",
    "error"
  ],
  "$defs": {
    "ArtifactDescriptor": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "byte_length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "identity": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "identity",
        "sha256",
        "byte_length",
        "media_type",
        "availability"
      ]
    },
    "ArtifactIdentity": {
      "type": "object",
      "properties": {
        "installation_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "revision_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_id": {
          "type": "string"
        },
        "store_epoch": {
          "type": "string"
        }
      },
      "required": [
        "installation_id",
        "store_epoch",
        "source_id",
        "revision",
        "revision_seq"
