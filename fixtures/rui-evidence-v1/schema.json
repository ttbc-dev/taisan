    },
    "Availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "retention_expired"
      ]
    },
    "CommandKind": {
      "type": "string",
      "enum": [
        "evidence_export",
        "evidence_artifact"
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "dismissed",
        "resolved",
        "unknown"
      ]
    },
    "EntityType": {
      "type": "string",
      "enum": [
        "work",
        "execution",
        "invocation",
        "review_round",
        "finding_occurrence",
        "repair_attempt",
        "verification",
        "outcome",
        "requirement",
        "invariant"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unsupported_protocol",
        "invalid_request",
        "invalid_cursor",
        "snapshot_expired",
        "checkpoint_expired",
        "installation_mismatch",
        "epoch_mismatch",
        "record_too_large",
        "artifact_unavailable",
        "artifact_too_large",
        "digest_mismatch",
        "store_error",
        "config_error"
      ]
    },
    "EvidenceClass": {
      "type": "string",
      "enum": [
        "body",
        "relation",
        "artifact",
        "history",
        "intent"
      ]
    },
    "ExportPage": {
      "type": "object",
      "properties": {
        "after_seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          }
        },
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Record"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          }
