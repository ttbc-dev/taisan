        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Record"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "retained_from_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "snapshot_id": {
          "type": "string"
        },
        "snapshot_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "store_epoch": {
          "type": "string"
        }
