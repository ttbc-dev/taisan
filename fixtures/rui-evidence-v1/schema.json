        {
          "type": "object",
          "properties": {
            "author": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "human_inference"
            },
            "rationale": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "author",
            "tool",
            "version",
            "rationale"
          ]
        },
        {
          "type": "object",
          "properties": {
            "author": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "model_interpretation"
            },
            "rationale": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "author",
            "tool",
            "version",
            "rationale"
          ]
        }
