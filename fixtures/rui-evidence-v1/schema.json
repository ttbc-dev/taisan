    "ExportRequest": {
      "type": "object",
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "protocol_version",
        "limit"
      ]
    },
    "Gap": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/GapCode"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "reason": {
