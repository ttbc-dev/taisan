    },
    "ArtifactRequest": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "artifact_id",
        "sha256"
      ]
    },
    "ArtifactResult": {
      "type": "object",
      "properties": {
        "bytes_written": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "descriptor": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "protocol_version",
        "descriptor",
        "bytes_written"
