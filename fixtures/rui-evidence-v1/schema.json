          "required": [
            "kind",
            "record"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact_id",
            "sha256"
          ]
        },
        {
          "type": "object",
          "properties": {
            "before_seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
