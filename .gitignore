/target

.DS_Store

# Credentials and secrets — the workspace handles app tokens and
# reference-based credentials (crates/workloop-core/src/credential.rs,
# scripts/s1/mint-app-token.py); never commit them.
.env
.env.*
*.pem
*.key
*.token
*-credentials.json
secrets/

# Agent-local state
.claude/settings.local.json
.mcp.json
opencode.json
.worktrees/

# Runtime state resolved in the working directory — CLI/TUI default
# `--db workloop.db` (with SQLite -wal/-shm/-journal sidecars) and the
# bridge's default `--config installation.json`; never commit them.
workloop.db
workloop.db-*
installation.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
